# ============================================================
# Deteksi Tanaman Melon — Backend (.env.example)
# Salin file ini menjadi `.env` lalu isi nilainya.
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (Linux/Mac)
# JANGAN commit file .env ke Git.
# ============================================================

# --- Aplikasi ---
APP_NAME="Deteksi Tanaman Melon"
APP_ENV=development
APP_VERSION=1.0.0
# Opsional: diisi pipeline deploy (ISO 8601); kosong = otomatis
# memakai waktu proses backend dimulai.
BUILD_TIME=
DEBUG=False

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=Melon123!
DB_NAME=deteksi_melon

# --- Autentikasi JWT ---
# Buat nilai acak: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-64-karakter
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Model AI (wajib; path relatif terhadap folder backend/) ---
MODEL_PATH=model/deteksi_melon_int8.tflite

# --- ESP32-CAM (opsional; kosongkan bila belum ada perangkat) ---
# Port 80 = snapshot /capture; stream port 81 diatur di frontend.
ESP32_URL=http://192.168.1.38
